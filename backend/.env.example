# Porta da API
PORT=3334

# Autenticacao do painel (dashboard)
JWT_SECRET=troque-por-um-segredo-forte

# WhatsApp Cloud API (Meta for Developers)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=coloque-o-token-permanente-aqui
WHATSAPP_PHONE_NUMBER_ID=coloque-o-phone-number-id-aqui
WHATSAPP_VERIFY_TOKEN=escolha-uma-frase-secreta-para-o-webhook
WHATSAPP_API_VERSION=v20.0

# Provedor de IA (qualquer API compativel com o formato "chat completions" da OpenAI)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=coloque-sua-chave-aqui
AI_MODEL=gpt-4o-mini

# Banco de dados
DB_FILE=./data.sqlite
